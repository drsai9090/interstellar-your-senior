# Safe default: fixed synthetic documents, no credentials or model downloads.
DEMO_MODE=true
STATIC_DIR=
YOUR_SENIOR_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Private development only (DEMO_MODE=false); never put keys in frontend env.
CHROMA_PERSIST_DIR=./chromadb_store
CHROMA_COLLECTION_NAME=your_senior_docs
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
GOOGLE_DRIVE_FOLDER_ID=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TOP_K_CHUNKS=5
MAX_CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
QUERY_LOG_MAX_ENTRIES=50
